---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const byYear = new Map<number, typeof posts>();
for (const p of posts) { const y = p.data.date.getFullYear(); byYear.set(y, [...(byYear.get(y) ?? []), p]); }
---
<Base title="博客" description="按时间排列的文章。">
  <h1 class="page-title">博客</h1>
  <p class="page-lead">投资、阅读与工作中的思考，按时间排列。</p>
  {posts.length === 0 && <p class="empty">还没有文章。</p>}
  {[...byYear].map(([year, list]) => (
    <section class="block" style="padding-top: 40px">
      <div class="head"><h2>{year}</h2><span>{list.length} 篇</span></div>
      {list.map((p) => <PostRow href={`/blog/${p.id}/`} title={p.data.title} date={p.data.date} />)}
    </section>
  ))}
</Base>
