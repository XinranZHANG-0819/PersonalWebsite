---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => !p.data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data.date.toISOString().slice(0, 10);
---
<Base title={post.data.title} description={post.data.description} type="article" size="read">
  <div slot="hero" class="page-hero"><div class="wrap read">
    <h1 class="page-title">{post.data.title}</h1>
    <p class="meta"><time datetime={d}>{d}</time>{post.data.updated && <span> · 更新于 <time datetime={post.data.updated.toISOString().slice(0, 10)}>{post.data.updated.toISOString().slice(0, 10)}</time></span>}</p>
    {post.data.tags.length > 0 && <div class="tags">{post.data.tags.map((t) => <span class="tag">{t}</span>)}</div>}
  </div></div>
  <article>
    <div class="prose"><Content /></div>
  </article>
  <p class="meta" style="margin-top: 56px"><a href="/blog/">← 返回文章</a></p>
</Base>
