---
import Base from '../../layouts/Base.astro';
---
<Base title="写文章" size="read" noindex>
  <div slot="hero" class="page-hero">
    <div class="wrap read">
      <h1 class="page-title">写文章</h1>
      <p class="page-lead">极简写作台 · 保存即提交至 GitHub，草稿仅本人可见。</p>
    </div>
  </div>

  <p id="token-note" class="w-banner" style="display:none" role="alert"></p>

  <section class="w-section">
    <form id="form" class="card w-editor" onsubmit="return false">
      <div class="w-toolbar">
        <div class="w-seg" role="group" aria-label="编辑或预览">
          <button type="button" id="tab-edit" class="on">编辑</button>
          <button type="button" id="tab-preview">预览</button>
        </div>
        <div class="w-actions">
          <label class="w-btn w-ghost" title="插入图片（支持拖拽或粘贴）">
            插图
            <input id="f-image" type="file" accept="image/*" hidden />
          </label>
          <button type="button" id="b-new" class="w-btn w-ghost">新建</button>
          <button type="button" id="b-draft" class="w-btn">存草稿</button>
          <button type="button" id="b-publish" class="w-btn w-primary">发布</button>
        </div>
      </div>

      <div id="edit-pane" class="w-body">
        <input
          id="f-title"
          class="w-title-input"
          type="text"
          maxlength="200"
          placeholder="文章标题…"
          autocomplete="off"
        />

        <div class="w-meta-row">
          <input id="f-date" class="w-meta-input w-date" type="date" aria-label="日期" />
          <span class="w-sep" aria-hidden="true">/</span>
          <input
            id="f-tags"
            class="w-meta-input w-tags"
            type="text"
            placeholder="标签（逗号分隔，如 中债，利率）"
            autocomplete="off"
            aria-label="标签"
          />
          <button type="button" id="toggle-adv" class="w-adv-btn" aria-expanded="false">摘要与文件名 ▾</button>
        </div>

        <div id="adv-box" class="w-adv" style="display:none">
          <label class="w-adv-field">
            <span>摘要</span>
            <input id="f-desc" type="text" maxlength="500" placeholder="一句话摘要（显示在列表和分享卡片里，可选）" autocomplete="off" />
          </label>
          <label class="w-adv-field">
            <span>文件名</span>
            <input id="f-slug" type="text" maxlength="120" placeholder="2026-11-28-my-post" autocomplete="off" spellcheck="false" />
          </label>
        </div>

        <textarea
          id="f-content"
          class="w-textarea"
          rows="18"
          placeholder="开始写作（Markdown · 支持拖拽或粘贴图片 · Ctrl/⌘+S 存草稿）…"
        ></textarea>
      </div>

      <div id="preview" class="prose w-preview" style="display:none"></div>

      <div class="w-footer">
        <span id="state" class="w-state" role="status"></span>
        <span id="img-state" class="w-img-state"></span>
      </div>
    </form>
  </section>

  <section class="block w-list-sec">
    <div class="head">
      <h2>已有文章</h2>
      <span id="count" class="w-count"></span>
    </div>
    <p id="list-state" class="w-state">加载中…</p>
    <div id="list" class="w-list"></div>
  </section>
</Base>

<style is:global>
  .w-banner {
    margin: 18px 0 0;
    padding: 10px 14px;
    border-radius: 10px;
    border: 1px solid color-mix(in srgb, var(--up) 45%, transparent);
    background: color-mix(in srgb, var(--up) 10%, transparent);
    color: var(--ink);
    font-size: 13px;
  }
  .w-section { padding-top: 24px; }
  .w-editor { padding: 18px 22px 16px; }
  .w-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }
  .w-seg {
    display: inline-flex;
    padding: 3px;
    border-radius: 999px;
    border: 1px solid var(--card-line);
    background: color-mix(in srgb, var(--bg) 55%, transparent);
  }
  .w-seg button {
    font: inherit;
    font-size: 12.5px;
    color: var(--ink-3);
    background: none;
    border: 0;
    border-radius: 999px;
    padding: 4px 13px;
    cursor: pointer;
    transition: color 0.15s, background 0.15s;
  }
  .w-seg button.on {
    color: var(--ink);
    background: color-mix(in srgb, var(--accent) 22%, transparent);
  }
  .w-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .w-btn {
    height: 32px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid var(--card-line);
    background: none;
    color: var(--ink-2);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .w-btn:hover { color: var(--ink); border-color: var(--accent); }
  .w-btn.w-ghost { border-color: transparent; padding: 0 10px; color: var(--ink-3); }
  .w-btn.w-ghost:hover { color: var(--ink); border-color: var(--card-line); }
  .w-btn.w-primary {
    color: var(--ink);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 22%, transparent);
    box-shadow: 0 0 18px color-mix(in srgb, var(--accent) 25%, transparent);
  }
  .w-btn.w-primary:hover { background: color-mix(in srgb, var(--accent) 34%, transparent); }
  .w-btn:disabled { opacity: 0.45; cursor: wait; }

  .w-body { padding-top: 18px; }
  .w-title-input {
    width: 100%;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: clamp(22px, 2.6vw, 28px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
    padding: 0 0 12px;
  }
  .w-title-input:focus { outline: none; }
  .w-title-input::placeholder { color: var(--ink-3); opacity: 0.65; }

  .w-meta-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    padding: 10px 0 12px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    font-size: 13px;
  }
  .w-meta-input {
    border: 0;
    background: transparent;
    color: var(--ink-2);
    font: inherit;
    padding: 2px 0;
  }
  .w-meta-input:focus { outline: none; color: var(--ink); }
  .w-meta-input::placeholder { color: var(--ink-3); opacity: 0.7; }
  .w-date { font-family: var(--mono); font-size: 12.5px; width: 124px; }
  .w-tags { flex: 1; min-width: 160px; }
  .w-sep { color: var(--line); user-select: none; }
  .w-adv-btn {
    border: 0;
    background: none;
    color: var(--ink-3);
    font: inherit;
    font-size: 12px;
    cursor: pointer;
    padding: 2px 4px;
  }
  .w-adv-btn:hover { color: var(--link); }

  .w-adv {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px 14px;
    padding: 12px 0 14px;
    border-bottom: 1px solid var(--line);
  }
  .w-adv-field { display: flex; flex-direction: column; gap: 4px; font-size: 12px; color: var(--ink-3); }
  .w-adv-field input {
    width: 100%;
    font: inherit;
    font-size: 13px;
    color: var(--ink);
    background: color-mix(in srgb, var(--ink) 4%, transparent);
    border: 1px solid var(--card-line);
    border-radius: 8px;
    padding: 7px 10px;
  }
  .w-adv-field input:focus { outline: 2px solid var(--accent-2); outline-offset: 1px; }
  #f-slug { font-family: var(--mono); font-size: 12.5px; }

  .w-textarea {
    display: block;
    width: 100%;
    margin-top: 14px;
    border: 0;
    background: transparent;
    color: var(--ink);
    font-family: var(--mono);
    font-size: 14.5px;
    line-height: 1.85;
    resize: vertical;
    min-height: 340px;
    padding: 0;
  }
  .w-textarea:focus { outline: none; }
  .w-textarea::placeholder { color: var(--ink-3); opacity: 0.6; }

  .w-preview { margin-top: 18px; min-height: 340px; }
  .w-footer {
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    min-height: 28px;
  }
  .w-state, .w-img-state, .w-count { font-size: 12.5px; color: var(--ink-3); margin: 0; }
  .w-state.err { color: var(--up); }

  .w-list-sec { padding-top: 44px; }
  .w-list { margin-top: 6px; }
  .w-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 13px 0;
    border-bottom: 1px solid var(--line);
  }
  .w-row.draft { opacity: 0.72; }
  .w-row-main { min-width: 0; display: flex; flex-direction: column; gap: 3px; }
  .w-row-title { font-size: 15.5px; color: var(--ink); display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .w-row-meta { font-family: var(--mono); font-size: 12px; color: var(--ink-3); }
  .w-badge {
    font-size: 11px;
    color: var(--ink-2);
    border: 1px solid var(--card-line);
    border-radius: 999px;
    padding: 0 7px;
    line-height: 1.6;
  }
  .w-row-acts { display: flex; align-items: center; gap: 12px; flex-shrink: 0; font-size: 13px; }
  .w-row-acts a, .w-row-acts button {
    background: none;
    border: 0;
    padding: 2px 0;
    font: inherit;
    color: var(--ink-3);
    cursor: pointer;
  }
  .w-row-acts a:hover, .w-row-acts button:hover { color: var(--link); }
  .w-row-acts button.danger:hover { color: var(--up); }

  @media (max-width: 640px) {
    .w-editor { padding: 14px 16px; }
    .w-adv { grid-template-columns: 1fr; }
    .w-row { flex-direction: column; gap: 6px; }
  }
</style>

<script>
  type Post = { file: string; sha: string; title: string; description: string; date: string; tags: string[]; draft: boolean };
  const $ = (id: string) => document.getElementById(id)! as HTMLInputElement;
  const titleEl = $('f-title'), descEl = $('f-desc'), dateEl = $('f-date'), tagsEl = $('f-tags'), slugEl = $('f-slug');
  const contentEl = document.getElementById('f-content')! as HTMLTextAreaElement;
  const editPane = document.getElementById('edit-pane')!;
  const previewEl = document.getElementById('preview')!;
  const advBox = document.getElementById('adv-box')!;
  const advBtn = document.getElementById('toggle-adv')!;
  const stateEl = document.getElementById('state')!;
  const listEl = document.getElementById('list')!;
  const listStateEl = document.getElementById('list-state')!;
  const countEl = document.getElementById('count')!;
  const tokenNoteEl = document.getElementById('token-note')!;
  const imgStateEl = document.getElementById('img-state')!;
  let currentFile: string | null = null;
  let slugDirty = false;

  function todayStr() {
    const d = new Date();
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
  }
  function slugify(s: string) {
    const t = s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 60).replace(/-+$/g, '');
    return t || 'post';
  }
  function suggestSlug() { if (!slugDirty) slugEl.value = `${dateEl.value || todayStr()}-${slugify(titleEl.value)}`; }
  titleEl.addEventListener('input', suggestSlug);
  dateEl.addEventListener('input', suggestSlug);
  slugEl.addEventListener('input', () => { slugDirty = true; });

  advBtn.addEventListener('click', () => {
    const open = advBox.style.display === 'none';
    advBox.style.display = open ? 'grid' : 'none';
    advBtn.setAttribute('aria-expanded', String(open));
    advBtn.textContent = open ? '收起设置 ▴' : '摘要与文件名 ▾';
  });

  function setState(msg: string, isErr = false) {
    stateEl.textContent = msg;
    stateEl.className = 'w-state' + (isErr ? ' err' : '');
  }

  async function api(method: string, url: string, body?: unknown) {
    const r = await fetch(url, { method, headers: { 'content-type': 'application/json' }, body: body ? JSON.stringify(body) : undefined });
    const j = await r.json().catch(() => ({}));
    if (!r.ok) { const e = new Error(j.error || String(r.status)) as Error & { status: number }; e.status = r.status; throw e; }
    return j;
  }

  function esc(s: string) { return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
  function inline(s: string) {
    return esc(s)
      .replace(/!\[([^\]]*)\]\(([^)\s]+)(?:\s+"[^"]*")?\)/g, '<img alt="$1" src="$2" />')
      .replace(/\[([^\]]+)\]\(([^)\s]+)(?:\s+"[^"]*")?\)/g, '<a href="$2">$1</a>')
      .replace(/`([^`]+)`/g, '<code>$1</code>')
      .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
      .replace(/(^|[^*])\*([^*\n]+)\*/g, '$1<em>$2</em>');
  }
  function renderMd(src: string) {
    const blocks: string[] = [];
    src = src.replace(/```([^\n]*)\n([\s\S]*?)```/g, (_m, _lang, code) => { blocks.push('<pre><code>' + esc(code.replace(/\n$/, '')) + '</code></pre>'); return `\n@@${blocks.length - 1}@@\n`; });
    const out: string[] = [];
    const lines = src.split('\n');
    let i = 0;
    while (i < lines.length) {
      const line = lines[i];
      const codeM = line.match(/^@@(\d+)@@$/);
      if (codeM) { out.push(blocks[+codeM[1]]); i++; continue; }
      const h = line.match(/^(#{1,3})\s+(.*)$/);
      if (h) { out.push(`<h${h[1].length}>${inline(h[2])}</h${h[1].length}>`); i++; continue; }
      if (/^\s*---+\s*$/.test(line)) { out.push('<hr />'); i++; continue; }
      if (/^\s*>/.test(line)) { const q: string[] = []; while (i < lines.length && /^\s*>/.test(lines[i])) { q.push(lines[i].replace(/^\s*>\s?/, '')); i++; } out.push('<blockquote>' + q.map((x) => inline(x)).join('<br />') + '</blockquote>'); continue; }
      if (/^\s*([-*]|\d+[.)])\s+/.test(line)) {
        const items: string[] = []; const ordered = /^\s*\d+[.)]\s+/.test(line);
        while (i < lines.length && /^\s*([-*]|\d+[.)])\s+/.test(lines[i])) { items.push(lines[i].replace(/^\s*([-*]|\d+[.)])\s+/, '')); i++; }
        out.push((ordered ? '<ol>' : '<ul>') + items.map((x) => '<li>' + inline(x) + '</li>').join('') + (ordered ? '</ol>' : '</ul>')); continue;
      }
      if (line.trim() === '') { i++; continue; }
      const para: string[] = [];
      while (i < lines.length && lines[i].trim() !== '' && !/^(#{1,3}\s|@@\d+@@$|\s*>|\s*([-*]|\d+[.)])\s+|\s*---+\s*$)/.test(lines[i])) { para.push(lines[i]); i++; }
      out.push('<p>' + para.map((x) => inline(x)).join('<br />') + '</p>');
    }
    return out.join('\n');
  }

  function updatePreview() {
    const heading = titleEl.value.trim() ? `<h1>${esc(titleEl.value.trim())}</h1>` : '';
    const meta = `<div class="meta">${esc(dateEl.value || todayStr())}${tagsEl.value.trim() ? ' · ' + esc(tagsEl.value.trim()) : ''}</div>`;
    previewEl.innerHTML = heading + meta + (contentEl.value.trim() ? renderMd(contentEl.value) : '<p class="empty">暂无正文内容</p>');
  }

  document.getElementById('tab-edit')!.addEventListener('click', () => {
    editPane.style.display = ''; previewEl.style.display = 'none';
    document.getElementById('tab-edit')!.classList.add('on');
    document.getElementById('tab-preview')!.classList.remove('on');
  });
  document.getElementById('tab-preview')!.addEventListener('click', () => {
    updatePreview(); editPane.style.display = 'none'; previewEl.style.display = '';
    document.getElementById('tab-preview')!.classList.add('on');
    document.getElementById('tab-edit')!.classList.remove('on');
  });

  async function loadList() {
    listStateEl.textContent = '加载中…';
    try {
      const j = await api('GET', '/api/admin/blog');
      const posts: Post[] = j.posts || [];
      listEl.textContent = '';
      countEl.textContent = `${posts.length} 篇`;
      listStateEl.textContent = posts.length ? '' : '还没有文章。';
      for (const p of posts) {
        const row = document.createElement('div');
        row.className = 'w-row' + (p.draft ? ' draft' : '');
        const main = document.createElement('div'); main.className = 'w-row-main';
        const ttl = document.createElement('div'); ttl.className = 'w-row-title'; ttl.textContent = p.title;
        if (p.draft) { const b = document.createElement('span'); b.className = 'w-badge'; b.textContent = '草稿'; ttl.append(b); }
        const meta = document.createElement('div'); meta.className = 'w-row-meta';
        meta.textContent = `${p.date || ''}${p.tags.length ? ' · ' + p.tags.join(' / ') : ''}`;
        main.append(ttl, meta);

        const acts = document.createElement('div'); acts.className = 'w-row-acts';
        if (!p.draft) { const a = document.createElement('a'); a.href = `/blog/${p.file.replace(/\.md$/, '')}/`; a.textContent = '查看'; acts.append(a); }
        const bEdit = document.createElement('button'); bEdit.type = 'button'; bEdit.textContent = '编辑';
        bEdit.onclick = () => loadPost(p.file);
        const bDel = document.createElement('button'); bDel.type = 'button'; bDel.className = 'danger'; bDel.textContent = '删除';
        let armed = false;
        bDel.onclick = async () => {
          if (!armed) { armed = true; bDel.textContent = '确认删除'; setTimeout(() => { armed = false; bDel.textContent = '删除'; }, 3000); return; }
          try { await api('DELETE', '/api/admin/blog?file=' + encodeURIComponent(p.file)); setState(`已删除 ${p.file}`); if (currentFile === p.file) newPost(); loadList(); }
          catch (e) { setState('删除失败：' + (e as Error).message, true); }
        };
        acts.append(bEdit, bDel);
        row.append(main, acts);
        listEl.append(row);
      }
    } catch (e) {
      const err = e as Error & { status: number };
      if (err.status === 401) listStateEl.textContent = '需要登录：请通过 Cloudflare Access 邮箱验证码进入。';
      else if (err.status === 503) {
        tokenNoteEl.style.display = '';
        tokenNoteEl.textContent = '未配置 GITHUB_TOKEN：当前可以本地起草，配置令牌并重部署后即可保存和读取列表。';
        listStateEl.textContent = '未配置 GITHUB_TOKEN，列表暂不可用。';
      } else listStateEl.textContent = '加载失败，请稍后再试。';
    }
  }

  async function loadPost(file: string) {
    try {
      const j = await api('GET', '/api/admin/blog?file=' + encodeURIComponent(file));
      currentFile = file;
      titleEl.value = j.title || ''; descEl.value = j.description || ''; dateEl.value = j.date || todayStr();
      tagsEl.value = (j.tags || []).join('，'); slugEl.value = file.replace(/\.md$/, ''); slugDirty = true;
      contentEl.value = j.content || '';
      document.getElementById('tab-edit')!.click();
      setState(`正在编辑 ${file}${j.draft ? '（草稿）' : ''}`);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } catch (e) { setState('打开失败：' + (e as Error).message, true); }
  }

  function newPost() {
    currentFile = null; slugDirty = false;
    titleEl.value = ''; descEl.value = ''; dateEl.value = todayStr(); tagsEl.value = ''; contentEl.value = '';
    suggestSlug(); setState('');
    document.getElementById('tab-edit')!.click();
  }
  document.getElementById('b-new')!.addEventListener('click', newPost);

  async function save(draft: boolean) {
    const title = titleEl.value.trim();
    const slug = slugEl.value.trim();
    const date = dateEl.value;
    if (!title) { setState('请先写文章标题。', true); titleEl.focus(); return; }
    if (!/^[a-z0-9]+(-[a-z0-9]+)*$/.test(slug)) {
      advBox.style.display = 'grid';
      setState('文件名只允许小写字母、数字和连字符。', true);
      slugEl.focus();
      return;
    }
    if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) { setState('日期格式不对。', true); return; }
    const btn = document.getElementById(draft ? 'b-draft' : 'b-publish')! as HTMLButtonElement;
    btn.disabled = true;
    setState('保存中…');
    try {
      const j = await api(currentFile ? 'PUT' : 'POST', '/api/admin/blog', {
        slug, title,
        description: descEl.value.trim(),
        date,
        tags: tagsEl.value.split(/[,，]/).map((s) => s.trim()).filter(Boolean),
        content: contentEl.value, draft,
      });
      setState(draft ? `已存草稿 ${j.file}` : `已发布 ${j.file}，自动部署后上线`);
      currentFile = j.file;
      loadList();
    } catch (e) {
      const err = e as Error & { status: number };
      if (err.status === 401) setState('需要管理员登录。', true);
      else if (err.status === 503) setState('未配置 GITHUB_TOKEN，暂无法保存。', true);
      else setState('保存失败：' + err.message, true);
    } finally { btn.disabled = false; }
  }
  document.getElementById('b-draft')!.addEventListener('click', () => save(true));
  document.getElementById('b-publish')!.addEventListener('click', () => save(false));
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 's') { e.preventDefault(); save(true); }
  });

  async function uploadImageFile(f: File) {
    imgStateEl.textContent = '上传图片中…';
    try {
      const dataUrl = await new Promise<string>((resolve, reject) => {
        const r = new FileReader(); r.onload = () => resolve(String(r.result)); r.onerror = reject; r.readAsDataURL(f);
      });
      const j = await api('POST', '/api/admin/blog', { imageName: f.name || 'image.png', dataBase64: dataUrl.split(',')[1] || '' });
      const alt = (f.name || 'image').replace(/\.[^.]+$/, '');
      const md = `![${alt}](${j.url})`;
      const start = contentEl.selectionStart ?? contentEl.value.length;
      const end = contentEl.selectionEnd ?? contentEl.value.length;
      contentEl.value = contentEl.value.slice(0, start) + md + contentEl.value.slice(end);
      contentEl.focus();
      contentEl.selectionStart = contentEl.selectionEnd = start + md.length;
      imgStateEl.textContent = `已插入 ${j.url}`;
    } catch (e) {
      const err = e as Error & { status: number };
      imgStateEl.textContent = err.status === 503 ? '未配置 GITHUB_TOKEN，暂不能上传图片' : '上传失败：' + err.message;
    }
  }
  document.getElementById('f-image')!.addEventListener('change', async (ev) => {
    const input = ev.target as HTMLInputElement;
    const f = input.files && input.files[0];
    if (f) await uploadImageFile(f);
    input.value = '';
  });
  contentEl.addEventListener('paste', async (ev) => {
    const items = ev.clipboardData?.items;
    if (!items) return;
    for (const it of items) {
      if (it.type.startsWith('image/')) {
        const f = it.getAsFile();
        if (f) { ev.preventDefault(); await uploadImageFile(f); }
        break;
      }
    }
  });

  dateEl.value = todayStr();
  suggestSlug();
  loadList();
</script>
