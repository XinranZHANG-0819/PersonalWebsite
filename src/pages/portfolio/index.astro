---
import Base from '../../layouts/Base.astro';
import P from '../../data/portfolio.json';
import { quotes, arrow, fmt, isDemo } from '../../lib-markets';

const states: Record<string, { glyph: string; cls: string }> = {
  buy: { glyph: '●', cls: 'buy' }, track: { glyph: '–', cls: 'wait' }, half: { glyph: '◐', cls: 'half' }, plan: { glyph: '■', cls: 'plan' }, wait: { glyph: '○', cls: 'wait' },
};

// 月度坐标：比特币窗口时间线（2026-01 ~ 2030-01）
const mi = (ym: string) => { const [y, m] = ym.split('-').map(Number); return (y - 2026) * 12 + (m - 1); };
const T0 = 0, T1 = 48;
const pct = (i: number) => ((i - T0) / (T1 - T0)) * 100;
const nowIdx = mi(P.report.readingsAsOf);

const all = quotes();
let indicators: Record<string, { points: [string, number][] }> = {};
try { indicators = (await import('../../data/indicators.json')).default.series as any; } catch {}
const live = (id?: string) => (id ? all.find((q) => q.id === id) : undefined);
const mk: Record<string, any> = {};
for (const x of P.signals as any[]) {
  if (!x.chart) continue;
  const id = x.chart.main; const q = live(id);
  if (q) mk[id] = { name: q.name, decimals: q.decimals, prefix: q.prefix, suffix: q.suffix, kind: q.kind, points: q.points };
  else if (x.chart.source === 'indicators' && indicators[id]) mk[id] = { name: x.chart.name, decimals: x.chart.decimals ?? 2, prefix: '', suffix: '', kind: 'nav', points: indicators[id].points };
}
const indLast = (id: string) => { const pts = indicators[id]?.points; return pts && pts.length ? pts[pts.length - 1][1] : null; };
const fmtN = (v: number, d: number) => v.toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d });
const heads: Record<string, { value: string; dir: 'up' | 'down' | 'flat'; text: string; label: string }> = {};
for (const x of P.signals as any[]) {
  if (!x.chart) continue;
  const m = mk[x.chart.main];
  if (!m || m.points.length < 2) continue;
  const a = m.points[m.points.length - 2][1], b = m.points[m.points.length - 1][1];
  const isY = m.kind === 'yield';
  const diff = isY ? (b - a) * 100 : ((b - a) / a) * 100;
  heads[x.id] = {
    value: `${m.prefix ?? ''}${fmtN(b, m.decimals)}${m.suffix ?? ''}`,
    // 四舍五入后是 0 的，按持平显示
    dir: Number(Math.abs(diff).toFixed(isY ? 1 : 2)) === 0 ? 'flat' : diff > 0 ? 'up' : 'down',
    text: isY ? `${Math.abs(diff).toFixed(1)} bp` : `${Math.abs(diff).toFixed(2)}%`,
    label: x.id === 'btc' ? '较前一日' : '较上一交易日',
  };
}
const groups = [
  { title: '', cards: (P.signals as any[]).filter((x) => !x.fx) },
  { title: '汇率', note: '', cards: (P.signals as any[]).filter((x) => x.fx) },
];
// 24 个月动量：每个点对比两年前最近一个点的涨幅（%）
const momentum = (pts: [string, number][]) => {
  const out: [string, number][] = [];
  let j = 0;
  for (let i = 0; i < pts.length; i++) {
    const t = new Date(pts[i][0] + 'T00:00:00Z').getTime() - 730 * 86400000;
    while (j + 1 < i && new Date(pts[j + 1][0] + 'T00:00:00Z').getTime() <= t) j++;
    if (new Date(pts[j][0] + 'T00:00:00Z').getTime() <= t) out.push([pts[i][0], Math.round(((pts[i][1] / pts[j][1]) - 1) * 1000) / 10]);
  }
  return out;
};
const indicatorPoints = (spec: any) => {
  if (!spec) return null;
  if (spec.source === 'markets') return live(spec.id)?.points ?? null;
  if (spec.derived === 'mom24') { const q = live(spec.from); return q ? momentum(q.points) : null; }
  return indicators[spec.id]?.points ?? null;
};
const charts = Object.fromEntries((P.signals as any[]).filter((x) => x.chart).map((x) => [x.id, {
  main: x.chart.main,
  spec: x.chart.indicator ?? null,
  ind: indicatorPoints(x.chart.indicator),
  bands: x.chart.bands ?? null,
}]));
---
<Base wide title="资产罗盘" description="各类资产的走势、观测指标和当前读数。">
  <h1 class="page-title">资产罗盘</h1>

  <!-- 2. 买卖信号 -->
  <section class="block" aria-label="资产走势与观测指标" style="padding-top: 36px">
    <div class="bar2">
      <div class="ranges" role="group" aria-label="时间范围">
        <button type="button" data-range="30">1 月</button>
        <button type="button" data-range="182">6 月</button>
        <button type="button" data-range="365" class="on">1 年</button>
        <button type="button" data-range="1095">3 年</button>
        <button type="button" data-range="1825">5 年</button>
        <button type="button" data-range="3650">10 年</button>
      </div>
      <span class="fine" style="margin:0">{isDemo ? '示例数据' : '行情每天自动更新'} · 读数日期 {P.report.readingsAsOf}</span>
    </div>
    {groups.map((g) => (
    <div class="grp">
      {g.title && <div class="head sm"><h2>{g.title}</h2><span>{g.note}</span></div>}
    <div class="signals">
      {g.cards.map((sig) => { const s: any = sig; return (
        <article class="sig" data-id={sig.id}>
          <header>
            <span class="asset">{s.asset}{s.chart && mk[s.chart.main] && mk[s.chart.main].name !== s.asset && <span class="sub">{mk[s.chart.main].name}</span>}</span>
            <span class="ret mono" data-ret></span>
          </header>
          {heads[s.id] && (
            <div class="hd">
              <span class="hv mono">{heads[s.id].value}</span>
              <span class={`hc mono ${heads[s.id].dir}`}>{heads[s.id].dir === 'flat' ? '' : `${arrow(heads[s.id].dir)} `}{heads[s.id].text}</span>
            </div>
          )}
          {s.chart && (
            <div class="chart" data-chart>
              {!mk[s.chart.main] && <p class="nodata">走势数据待下一次自动更新</p>}
            </div>
          )}
          {!s.chart && <p class="nodata">暂无免费数据源，待接入</p>}
          <div class="bottom" hidden={!(s.metric || s.stateText || s.reading || s.readIndicator || s.showLive || s.gauge)}>
          {s.metric && <div class="metric">{s.metric}</div>}
          <div class="rd">
            <div class="reading mono">{s.live ? (s.showLive && live(s.live) ? `${fmt(live(s.live)!.last, live(s.live)!.decimals)}${live(s.live)!.suffix}` : '') : s.readIndicator ? (indLast(s.readIndicator) != null ? `${indLast(s.readIndicator)!.toFixed(2)}%` : '') : s.reading}</div>
            {s.stateText && <span class={`pill ${states[s.state].cls}`}><i aria-hidden="true">{states[s.state].glyph}</i>{s.stateText}</span>}
          </div>

          {s.gauge?.type === 'range' && (
            <div class="gauge" role="img" aria-label={`${s.metric} ${s.gauge.value}${s.gauge.unit}，阈值 ${s.gauge.marks.join('、')}`}>
              <div class="track">
                <span class="zone z1" style={`width:${s.gauge.marks[0]}%`}></span>
                <span class="zone z2" style={`left:${s.gauge.marks[0]}%;width:${s.gauge.marks[1] - s.gauge.marks[0]}%`}></span>
                <span class="zone z3" style={`left:${s.gauge.marks[1]}%;right:0`}></span>
                <span class="mk" style={`left:${s.gauge.value}%`}></span>
              </div>
              <div class="ticks mono">
                <span style="left:0">0</span>
                <span style={`left:${s.gauge.marks[0]}%`}>{s.gauge.marks[0]}</span>
                <span style={`left:${s.gauge.marks[1]}%`}>{s.gauge.marks[1]}</span>
                <span style="left:100%">100</span>
              </div>
            </div>
          )}
          {s.gauge?.type === 'zero' && (
            <div class="gauge" role="img" aria-label={`${s.metric} ${s.gauge.value}${s.gauge.unit}，零线为分界`}>
              <div class="track">
                <span class="zone z-neg" style={`width:${(0 - s.gauge.min) / (s.gauge.max - s.gauge.min) * 100}%`}></span>
                <span class="zone z-pos" style={`left:${(0 - s.gauge.min) / (s.gauge.max - s.gauge.min) * 100}%;right:0`}></span>
                <span class="mk" style={`left:${(s.gauge.value - s.gauge.min) / (s.gauge.max - s.gauge.min) * 100}%`}></span>
              </div>
              <div class="ticks mono">
                <span style="left:0">{s.gauge.min}%</span>
                <span style={`left:${(0 - s.gauge.min) / (s.gauge.max - s.gauge.min) * 100}%`}>0</span>
                <span style="left:100%">+{s.gauge.max}%</span>
              </div>
            </div>
          )}
          {s.gauge?.type === 'window' && (
            <div class="gauge" role="img" aria-label={`减半窗口 ${P.btcWindow.start} 至 ${P.btcWindow.end}，目前在窗口外`}>
              <div class="track tl">
                <span class="zone win" style={`left:${pct(mi(P.btcWindow.start))}%;width:${pct(mi(P.btcWindow.end)) - pct(mi(P.btcWindow.start))}%`}></span>
                <span class="halv" style={`left:${pct(mi(P.btcWindow.halving))}%`}></span>
                <span class="mk" style={`left:${pct(nowIdx)}%`}></span>
              </div>
              <div class="ticks mono">
                {[2026, 2027, 2028, 2029, 2030].map((y) => <span style={`left:${pct((y - 2026) * 12)}%`}>{y}</span>)}
              </div>
            </div>
          )}

          </div>
        </article>
      ); })}
    </div>
    </div>
    ))}
  </section>

  <p class="fine disclaimer">个人记录，不构成投资建议。</p>
  <script type="application/json" id="pf-data" set:html={JSON.stringify({ mk, charts })} />
</Base>

<style>
  .mono { font-family: var(--mono); }
  .fine { margin: 14px 0 0; font-size: 13px; color: var(--ink-3); line-height: 1.7; }
  .block { padding-top: 48px; }


  .signals { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-top: 24px; }
  .sig { min-width: 0; display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 14px; padding: 22px 24px 24px; }
  .sig header { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin-bottom: 4px; }
  .hd { margin-top: 10px; display: flex; align-items: baseline; justify-content: space-between; gap: 4px 14px; flex-wrap: wrap; }
  .hv { font-size: 28px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.2; }
  .hc { font-size: 13px; text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .muted { color: var(--ink-3); font-family: var(--sans); }
  .up { color: var(--up); } .down { color: var(--down); } .flat { color: var(--ink-3); }
  .ret { font-size: 13px; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .ret .lab { color: var(--ink-3); font-family: var(--sans); margin-right: 6px; }
  .grp + .grp { margin-top: 48px; }
  .head.sm { margin-top: 0; }
  .asset { font-size: 17px; font-weight: 600; }
  .asset .sub { font-size: 13px; font-weight: 400; color: var(--ink-3); margin-left: 10px; }
  .rd { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 4px; }
  .sig.wide { display: grid; grid-template-columns: minmax(200px, 280px) minmax(0, 1fr); column-gap: 48px; align-items: center; }
  .sig.wide > * { grid-column: 1; }
  .sig.wide > .chart { grid-column: 2; grid-row: 1 / span 6; margin: 0; }
  .pill { display: inline-flex; align-items: center; gap: 5px; font-size: 12.5px; border: 1px solid var(--line); border-radius: 999px; padding: 1px 10px; color: var(--ink-2); white-space: nowrap; }
  .pill i { font-style: normal; font-size: 10px; }
  .pill.buy { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); }
  .pill.half { color: var(--ink); }
  .metric { font-size: 13px; color: var(--ink-3); margin-top: 6px; }
  .reading { font-size: 18px; font-weight: 500; letter-spacing: -0.01em; }

  .bar2 { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-top: 18px; }
  .ranges { display: flex; gap: 4px; }
  .ranges button { font: inherit; font-size: 13px; color: var(--ink-2); background: none; border: 1px solid transparent; border-radius: 999px; padding: 4px 12px; cursor: pointer; }
  .ranges button:hover { color: var(--ink); }
  .ranges button.on { color: var(--ink); border-color: var(--line); background: color-mix(in srgb, var(--ink) 5%, transparent); }
  .chart { position: relative; margin: 12px 0 14px; min-height: 210px; }
  .bottom { margin-top: auto; }
  .nodata { margin: 12px 0 6px; font-size: 13px; color: var(--ink-3); }
  .gauge { margin-top: 10px; }
  .track { position: relative; height: 8px; border-radius: 4px; background: var(--line); overflow: visible; }
  .zone { position: absolute; top: 0; bottom: 0; }
  .z1 { left: 0; background: color-mix(in srgb, var(--accent) 38%, var(--line)); border-radius: 4px 0 0 4px; }
  .z2 { background: color-mix(in srgb, var(--accent) 20%, var(--line)); }
  .z3 { background: var(--line); border-radius: 0 4px 4px 0; }
  .z-neg { left: 0; background: var(--line); border-radius: 4px 0 0 4px; }
  .z-pos { background: color-mix(in srgb, var(--accent) 30%, var(--line)); border-radius: 0 4px 4px 0; }
  .win { background: color-mix(in srgb, var(--accent) 32%, var(--line)); border-radius: 4px; }
  .halv { position: absolute; top: -3px; bottom: -3px; width: 2px; background: var(--ink-3); }
  .mk { position: absolute; top: 50%; width: 14px; height: 14px; margin: -7px 0 0 -7px; border-radius: 50%; background: var(--ink); border: 3px solid var(--bg); box-sizing: border-box; }
  .ticks { position: relative; height: 18px; margin-top: 8px; font-size: 11px; color: var(--ink-3); }
  .ticks span { position: absolute; transform: translateX(-50%); }
  .ticks span:first-child { transform: none; }
  .ticks span:last-child { transform: translateX(-100%); }
  .zones { display: flex; font-size: 12px; color: var(--ink-3); }
  .zones span { text-align: center; }
  .tl-note span { text-align: left; }

  @media (max-width: 1180px) { .signals { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 720px) {
    .signals { grid-template-columns: minmax(0, 1fr); }
    .sig { padding: 20px; }
  }
</style>


<script>
  import { mountChart } from '../../scripts/chart';
  const raw = JSON.parse(document.getElementById('pf-data')!.textContent || '{}');
  const mk = raw.mk as Record<string, any>;
  const charts = raw.charts as Record<string, { main: string; spec: any; ind: [string, number][] | null; bands: any }>;
  const LABELS: Record<number, string> = { 30: '近 1 月', 182: '近 6 月', 365: '近 1 年', 1095: '近 3 年', 1825: '近 5 年', 3650: '近 10 年' };
  const addMonths = (iso: string, n: number) => { const d = new Date(iso + 'T00:00:00Z'); d.setUTCMonth(d.getUTCMonth() + n); return d.toISOString().slice(0, 10); };
  let days = 365;
  function setReturn(card: HTMLElement, kind: string, first: number, last: number) {
    const out = card.querySelector<HTMLElement>('[data-ret]');
    if (!out) return;
    const up = last > first, flat = last === first;
    const arrow = up ? '▲ ' : flat ? '' : '▼ ';
    const val = kind === 'yield' ? `${arrow}${Math.abs((last - first) * 100).toFixed(1)} bp` : `${arrow}${Math.abs(((last - first) / first) * 100).toFixed(2)}%`;
    out.textContent = '';
    const lab = document.createElement('span'); lab.textContent = LABELS[days] || ''; lab.style.cssText = 'color:var(--ink-3);font-family:var(--sans);margin-right:6px';
    const num = document.createElement('span'); num.textContent = val;
    num.style.color = flat ? 'var(--ink-3)' : up ? 'var(--up)' : 'var(--down)';
    out.append(lab, num);
  }
  function renderAll() {
    document.querySelectorAll<HTMLElement>('.sig').forEach((card) => {
      const id = card.dataset.id!;
      const box = card.querySelector<HTMLElement>('[data-chart]');
      const c = charts[id];
      if (!box || !c || !mk[c.main]) return;
      const m = mk[c.main];
      const panels: any[] = [{ label: m.name, points: m.points, decimals: m.decimals, prefix: m.prefix, suffix: m.suffix, color: 'var(--accent)', height: 210, area: true, caption: false }];
      if (c.bands) { panels[0].bands = c.bands.halvings.map((h: string) => [addMonths(h, -c.bands.before), addMonths(h, c.bands.after)]); panels[0].bandLabel = c.bands.label; }
      if (c.ind && c.spec) panels.push({ label: c.spec.label, points: c.ind, decimals: c.spec.decimals, suffix: c.spec.suffix, color: 'var(--series2)', height: 210, overlay: true, domain: c.spec.domain, ticks: c.spec.ticks, refs: c.spec.refs });
      const note = box.querySelector('.nodata');
      box.textContent = '';
      if (note) box.appendChild(note);
      const holder = document.createElement('div');
      box.insertBefore(holder, box.firstChild);
      const narrow = box.clientWidth < 420;
      const st = mountChart(holder, panels, days, { L: narrow ? 54 : 66, R: narrow ? 40 : 50 });
      if (st) setReturn(card, m.kind, st.first, st.last);
    });
  }
  renderAll();
  let t: number;
  window.addEventListener('resize', () => { clearTimeout(t); t = window.setTimeout(renderAll, 120); });
  new MutationObserver(renderAll).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  document.querySelectorAll<HTMLButtonElement>('[data-range]').forEach((b) => b.addEventListener('click', () => {
    days = Number(b.dataset.range);
    document.querySelectorAll('[data-range]').forEach((o) => o.classList.toggle('on', o === b));
    renderAll();
  }));
</script>
